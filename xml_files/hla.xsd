<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://hla.alleles.org/xml" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:x="http://hla.alleles.org/xml">
  <xs:import namespace="http://www.w3.org/2001/XMLSchema" schemaLocation="xs.xsd"/>
  <xs:element name="release">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="x:alleles"/>
      </xs:sequence>
      <xs:attribute name="date" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="version" use="required" type="xs:NMTOKEN"/>
      <xs:attribute ref="xs:noNamespaceSchemaLocation" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="alleles">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:allele"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="allele">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="x:releaseversions"/>
        <xs:element ref="x:locus"/>
        <xs:element maxOccurs="unbounded" ref="x:cwd_catalogue"/>
        <xs:element ref="x:hla_g_group"/>
        <xs:element ref="x:hla_p_group"/>
        <xs:element ref="x:antigen_assignments"/>
        <xs:element minOccurs="0" ref="x:citations"/>
        <xs:element ref="x:sourcexrefs"/>
        <xs:element ref="x:sourcematerial"/>
        <xs:element ref="x:sequence"/>
      </xs:sequence>
      <xs:attribute name="dateassigned" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="id" use="required" type="xs:NCName"/>
      <xs:attribute name="name" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="releaseversions">
    <xs:complexType>
      <xs:attribute name="confirmed" use="required" type="xs:NCName"/>
      <xs:attribute name="currentrelease" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="firstreleased" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="lastupdated" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="releasecomments" use="required"/>
      <xs:attribute name="releasestatus" use="required" type="xs:NCName"/>
      <xs:attribute name="sversion" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="locus">
    <xs:complexType>
      <xs:attribute name="class" use="required" type="xs:NCName"/>
      <xs:attribute name="genesystem" use="required" type="xs:NCName"/>
      <xs:attribute name="hugogenename" use="required" type="xs:NCName"/>
      <xs:attribute name="locusname" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="cwd_catalogue">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:cwd_entry"/>
      </xs:sequence>
      <xs:attribute name="cwd_reference" use="required" type="xs:anyURI"/>
      <xs:attribute name="cwd_version" use="required" type="xs:NMTOKEN"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="cwd_entry">
    <xs:complexType>
      <xs:attribute name="afa"/>
      <xs:attribute name="api"/>
      <xs:attribute name="euro" type="xs:NCName"/>
      <xs:attribute name="group" type="xs:NMTOKEN"/>
      <xs:attribute name="his"/>
      <xs:attribute name="mena"/>
      <xs:attribute name="nam"/>
      <xs:attribute name="name"/>
      <xs:attribute name="population" type="xs:NCName"/>
      <xs:attribute name="status" type="xs:NCName"/>
      <xs:attribute name="total" type="xs:NCName"/>
      <xs:attribute name="unk"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="hla_g_group">
    <xs:complexType>
      <xs:attribute name="id" use="required" type="xs:NCName"/>
      <xs:attribute name="name" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="hla_p_group">
    <xs:complexType>
      <xs:attribute name="id" use="required" type="xs:NCName"/>
      <xs:attribute name="name" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="antigen_assignments">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" ref="x:who_assigned"/>
        <xs:element minOccurs="0" ref="x:hats_assigned"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="who_assigned">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" ref="x:broad"/>
        <xs:element minOccurs="0" ref="x:split"/>
        <xs:element minOccurs="0" ref="x:associated"/>
      </xs:sequence>
      <xs:attribute name="expression" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="hats_assigned">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="x:broad"/>
        <xs:element minOccurs="0" ref="x:split"/>
        <xs:element minOccurs="0" ref="x:associated"/>
      </xs:sequence>
      <xs:attribute name="qualifier" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="citations">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:citation"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="citation">
    <xs:complexType>
      <xs:attribute name="authors" use="required"/>
      <xs:attribute name="location" use="required"/>
      <xs:attribute name="pubmed" use="required" type="xs:integer"/>
      <xs:attribute name="title" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="sourcexrefs">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:xref"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="xref">
    <xs:complexType>
      <xs:attribute name="acc" use="required" type="xs:NCName"/>
      <xs:attribute name="pid" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="sourcematerial">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="x:species"/>
        <xs:element ref="x:ancestry"/>
        <xs:element ref="x:samples"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="species">
    <xs:complexType>
      <xs:attribute name="commonname" use="required" type="xs:NCName"/>
      <xs:attribute name="latinname" use="required"/>
      <xs:attribute name="ncbitaxon" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="ancestry">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:sample_ancestry"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="sample_ancestry" type="xs:string"/>
  <xs:element name="samples">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:sample"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="sample">
    <xs:complexType>
      <xs:attribute name="name" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="sequence">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="x:nucsequence"/>
        <xs:element ref="x:cds_features"/>
        <xs:element maxOccurs="unbounded" ref="x:feature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="nucsequence">
    <xs:complexType mixed="true">
      <xs:attribute name="length" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="cds_features">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="x:cds_position"/>
      </xs:sequence>
      <xs:attribute name="full_cds" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="cds_position">
    <xs:complexType>
      <xs:attribute name="start" use="required" type="xs:integer"/>
      <xs:attribute name="stop" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="feature">
    <xs:complexType>
      <xs:choice>
        <xs:element ref="x:SequenceCoordinates"/>
        <xs:element ref="x:translation"/>
      </xs:choice>
      <xs:attribute name="featuretype" use="required" type="xs:NCName"/>
      <xs:attribute name="id" use="required" type="xs:decimal"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="order" type="xs:integer"/>
      <xs:attribute name="pseudo" type="xs:NCName"/>
      <xs:attribute name="pseudogene" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="SequenceCoordinates">
    <xs:complexType>
      <xs:attribute name="end" use="required" type="xs:integer"/>
      <xs:attribute name="start" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="translation" type="xs:string"/>
  <xs:element name="broad" type="xs:NCName"/>
  <xs:element name="split" type="xs:NCName"/>
  <xs:element name="associated" type="xs:NCName"/>
</xs:schema>
